# ExportFlow Environment Configuration

PORT=5000
NODE_ENV=development

# MongoDB Connection String (If omitted or connection fails, will auto-fallback to embedded mongodb-memory-server)
MONGODB_URI=mongodb://localhost:27017/exportflow

# JWT Auth Secret
JWT_SECRET=exportflow_super_secret_jwt_key_2026_industrial_b2b_app

# B2B Buyer Discovery Provider Credentials (Optional - fallback to Mock Mode if omitted)
# Official Apollo.io B2B Intelligence Key
APOLLO_API_KEY=
# Google Places Business Search Key
GOOGLE_MAPS_API_KEY=

# Google OAuth Credentials for Gmail Integration (Optional - fallback to Mock Mode if omitted)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback

# AI Provider API Keys (Optional - fallback to Mock AI Classifier & Personalizer if omitted)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
AI_PROVIDER=mock # Options: mock | gemini | openai

# Email Validation API Key (Optional - fallback to Mock Validation Service if omitted)
EMAIL_VALIDATION_API_KEY=your-email-validation-key
EMAIL_VALIDATION_PROVIDER=mock # Options: mock | hunter | zerobounce | debounce

# Redis Queue Configuration (Optional - falls back to async in-memory queue)
REDIS_URL=redis://localhost:6379
